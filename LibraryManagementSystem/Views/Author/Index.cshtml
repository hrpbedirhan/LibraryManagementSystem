@model List<AuthorViewModel>
@{
    ViewData["Title"] = "Yazarlar";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-primary">Yazar Listesi</h1>
        <a class="btn btn-success btn-lg" asp-controller="Author" asp-action="Add">
            <i class="fas fa-plus"></i> Yeni Yazar Ekle
        </a>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <table class="table table-bordered table-hover">
        <thead class="table-light">
            <tr>
                <th scope="col">Yazar Adı</th>
                <th scope="col">Eser Sayısı</th>
                <th scope="col">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var author in Model)
            {
                <tr>
                    <td>@author.FullName</td>
                    <td>@author.BookCount</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@author.Id" class="btn btn-info btn-sm text-white">
                            <i class="fas fa-info-circle"></i>
                        </a>
                        <a asp-action="Edit" asp-route-id="@author.Id" class="btn btn-warning btn-sm text-white">
                            <i class="fas fa-edit"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@author.Id" class="btn btn-danger btn-sm">
                            <i class="fas fa-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
