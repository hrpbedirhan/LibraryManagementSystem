@model AuthorViewModel
@{
    ViewData["Title"] = "Yazar Detayı";
}

<div class="container mt-5">
    <div class="position-relative p-4 border rounded shadow-sm bg-light">
        <a asp-action="Index" class="btn btn-outline-danger position-absolute top-0 end-0 mt-3 me-3">
            <i class="fas fa-times"></i>
        </a>
        
        <h2 class="text-primary mb-4">Yazar Detayları</h2>

        <div class="px-3">
            <div class="mb-3">
                <h5 class="text-muted">Yazar:</h5>
                <p class="text-dark fs-5">@Model.FullName</p>
            </div>
            <div class="mb-3">
                <h5 class="text-muted">Eser Sayısı:</h5>
                <p class="text-dark fs-5">@Model.BookCount</p>
            </div>
            <div class="mb-3">
                <h5 class="text-muted">Doğum Tarihi:</h5>
                <p class="text-dark fs-5">@Model.DateOfBirth.ToShortDateString()</p>
            </div>
        </div>
    </div>
</div>
