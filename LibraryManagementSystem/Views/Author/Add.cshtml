@model AddAuthorViewModel
@{
    ViewData["Title"] = "Yazar Ekle";
}

<div class="container mt-4">
    <h1 class="text-primary mb-4"><i class="fas fa-user-plus"></i> Yeni Yazar Ekle</h1>

    <form method="post" class="shadow p-4 rounded bg-light">
        <div class="mb-3">
            <label asp-for="FirstName" class="form-label fw-bold">Ad</label>
            <input asp-for="FirstName" class="form-control" placeholder="Yazarın adını giriniz">
            <div class="form-text text-danger">
                <span asp-validation-for="FirstName"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="LastName" class="form-label fw-bold">Soyad</label>
            <input asp-for="LastName" class="form-control" placeholder="Yazarın soyadını giriniz">
            <div class="form-text text-danger">
                <span asp-validation-for="LastName"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="DateOfBirth" class="form-label fw-bold">Doğum Tarihi</label>
            <input asp-for="DateOfBirth" type="date" class="form-control">
            <div class="form-text text-danger">
                <span asp-validation-for="DateOfBirth"></span>
            </div>
        </div>

        <div class="d-flex justify-content-between mt-4">
            <a class="btn btn-secondary btn-lg" asp-action="Index">
                <i class="fas fa-times-circle"></i> Vazgeç
            </a>
            <button type="submit" class="btn btn-primary btn-lg">
                <i class="fas fa-save"></i> Kaydet
            </button>
        </div>
    </form>
</div>
