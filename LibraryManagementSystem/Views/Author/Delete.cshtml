@model Author
@{
	ViewData["Title"] = "Yazar Sil";
}


<div class="container mt-4">
    <h1 class="text-danger mb-4"><i class="fas fa-trash-alt"></i> Yazar Silme Onayı</h1>

    <div class="alert alert-warning text-center">
        <p>
            <strong>&quot;@Model.FirstName @Model.LastName&quot;</strong> adlı yazarı silmek istediğinize emin misiniz?
        </p>
    </div>

    <div class="d-flex justify-content-center mt-4">
        <form asp-action="DeleteConfirm" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger btn-lg me-2">
                <i class="fas fa-check-circle"></i> Evet, sil!
            </button>
        </form>

        <a class="btn btn-secondary btn-lg" asp-action="Index">
            <i class="fas fa-times-circle"></i> Vazgeç
        </a>
    </div>
</div>
