@model AddBookViewModel


<h1>Yeni Öğrenci</h1>

<form method="post">
    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control">
        <div class="form-text text-danger">
            <span asp-validation-for="Title"></span>
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="Genre" class="form-label"></label>
        <input asp-for="Genre" class="form-control">
        <div class="form-text text-danger">
            <span asp-validation-for="Genre"></span>
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="PublishDate" class="form-label"></label>
        <input asp-for="PublishDate" type="date" class="form-control">
        <div class="form-text text-danger">
            <span asp-validation-for="PublishDate"></span>
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="ISBN" class="form-label"></label>
        <input asp-for="ISBN" class="form-control">
        <div class="form-text text-danger">
            <span asp-validation-for="ISBN"></span>
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="CopiesAvailable" class="form-label"></label>
        <input asp-for="CopiesAvailable" class="form-control">
        <div class="form-text text-danger">
            <span asp-validation-for="CopiesAvailable"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="AuthorId" class="form-label"></label>
        <select asp-for="AuthorId" class="form-select">
            <option value="">Seçiniz</option>
            @foreach (var author in ViewData["Author"] as List<Author>)
            {
                <option value="@author.Id">@author.FirstName @author.LastName</option>
            }
        </select>
        <div class="form-text text-danger">
            <span asp-validation-for="AuthorId"></span>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a class="btn btn-secondary" asp-action="Index">Vazgeç</a>
</form>