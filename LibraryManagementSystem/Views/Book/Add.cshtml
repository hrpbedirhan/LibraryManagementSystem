@model AddBookViewModel
@{
    ViewData["Title"] = "Kitap Ekle";
}

<div class="container mt-4">
    <h1 class="text-primary mb-4"><i class="fas fa-book"></i> Yeni Kitap Ekle</h1>

    <form method="post" class="shadow p-4 rounded bg-light">
        <div class="mb-3">
            <label asp-for="Title" class="form-label fw-bold">Kitap Adı</label>
            <input asp-for="Title" class="form-control" placeholder="Kitap adını giriniz">
            <div class="form-text text-danger">
                <span asp-validation-for="Title"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Genre" class="form-label fw-bold">Tür</label>
            <input asp-for="Genre" class="form-control" placeholder="Kitap türünü giriniz">
            <div class="form-text text-danger">
                <span asp-validation-for="Genre"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="PublishDate" class="form-label fw-bold">Yayın Tarihi</label>
            <input asp-for="PublishDate" type="date" class="form-control">
            <div class="form-text text-danger">
                <span asp-validation-for="PublishDate"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="ISBN" class="form-label fw-bold">ISBN</label>
            <input asp-for="ISBN" class="form-control" placeholder="ISBN numarasını giriniz">
            <div class="form-text text-danger">
                <span asp-validation-for="ISBN"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="CopiesAvailable" class="form-label fw-bold">Mevcut Adet</label>
            <input asp-for="CopiesAvailable" class="form-control" type="number" placeholder="Mevcut kitap adetini giriniz">
            <div class="form-text text-danger">
                <span asp-validation-for="CopiesAvailable"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="AuthorId" class="form-label fw-bold">Yazar</label>
            <select asp-for="AuthorId" class="form-select">
                <option value="">Yazar seçiniz</option>
                @foreach (var author in ViewData["Author"] as List<Author>)
                {
                    <option value="@author.Id">
                        @author.FirstName @author.LastName
                    </option>
                }
            </select>
            <div class="form-text text-danger">
                <span asp-validation-for="AuthorId"></span>
            </div>
        </div>

        <div class="d-flex justify-content-between mt-4">
            <a class="btn btn-secondary btn-lg" asp-action="Index">
                <i class="fas fa-times-circle"></i> Vazgeç
            </a>
            <button type="submit" class="btn btn-primary btn-lg">
                <i class="fas fa-save"></i> Kaydet
            </button>
        </div>
    </form>
</div>
