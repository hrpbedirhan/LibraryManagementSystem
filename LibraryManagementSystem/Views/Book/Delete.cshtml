@model Book

<h1>Silme Onayı</h1>

<form asp-action="DeleteConfirm" asp-route-id="@Model.Id" method="post">

    <input type="hidden" asp-for="Id" />

    <p>&quot;@Model.Title&quot; adlı kitabı silmek istediğinize emin misiniz?</p>

    <button class="btn btn-primary">Evet, sil!</button>
    <a class="btn btn-secondary" asp-action="Index">Vazgeç</a>

</form>